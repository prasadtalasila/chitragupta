{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/citation_gate_hook.py",
            "timeout": 30,
            "statusMessage": "Checking citekeys against the ledger..."
          },
          {
            "type": "command",
            "command": "python .claude/hooks/style_check_hook.py",
            "timeout": 30,
            "statusMessage": "Checking the draft's prose..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_start_hook.py",
            "timeout": 30,
            "statusMessage": "Checking the project is ready to draft..."
          }
        ]
      }
    ]
  }
}
