# Settings for scripts/rc-daemon.sh, sourced at startup. Each line keeps
# a value already in the environment, so a one-off override still works:
#   RC_NAME=other scripts/rc-daemon.sh start
# See docs/DEV-ENV.md.

# Directory claude remote-control runs in; it must be a trusted workspace.
RC_DIR="${RC_DIR:-/workspace}"
# Remote Control session name, and the prefix for sessions spawned from it.
RC_NAME="${RC_NAME:-chitragupta-dev}"
RC_PREFIX="${RC_PREFIX:-chitragupta-dev}"
RC_PERMISSION_MODE="${RC_PERMISSION_MODE:-bypassPermissions}"
# Distinct per daemon, so two copies of the script can run side by side.
TMUX_SESSION="${TMUX_SESSION:-chitragupta-dev}"
RC_LOG="${RC_LOG:-$HOME/claude-daemon/chitragupta-dev.log}"
