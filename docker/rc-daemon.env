# Settings for rc-daemon.sh, sourced at startup (RC_ENV_FILE points elsewhere).
# Every line keeps a value already in the environment, so docker-compose.yml's
# `environment:` block, `docker exec -e`, and a one-off
# `RC_NAME=other rc-daemon.sh start` all override these defaults.

# Directory claude remote-control runs in. It must be a trusted workspace;
# entrypoint.sh records that trust before starting the daemon.
RC_DIR="${RC_DIR:-/workspace}"
# The agent's name in the remote-control UI, and the prefix for sessions it
# spawns. docker-compose.yml sets CLAUDE_AGENT_NAME from the container name.
RC_NAME="${RC_NAME:-${CLAUDE_AGENT_NAME:-$(hostname)}}"
RC_PREFIX="${RC_PREFIX:-$RC_NAME}"
RC_PERMISSION_MODE="${RC_PERMISSION_MODE:-bypassPermissions}"
# How a session started from the app gets its directory: worktree (its own
# git worktree of RC_DIR), same-dir (all sessions share RC_DIR) or session.
# worktree falls back to same-dir, with a line in the log, when RC_DIR is
# not a git repository.
RC_SPAWN="${RC_SPAWN:-worktree}"
# Distinct per daemon, so two copies of the script can run side by side.
TMUX_SESSION="${TMUX_SESSION:-rc-daemon}"
RC_LOG="${RC_LOG:-$HOME/rc-daemon.log}"

# Optional: run claude from a different venv than the image's /opt/venv, e.g.
# one inside the workspace. Unset, claude inherits /opt/venv from the image's
# ENV.
#
# Moved to the front, not merely added if missing. This file is sourced
# twice: by `start`, and again by `_supervise` inside tmux, whose login
# shell has meanwhile run /etc/profile.d's snippet and put /opt/venv/bin
# back in front. A "skip if already present" guard then left RC_VENV behind
# /opt/venv, so VIRTUAL_ENV named one venv while `python` resolved to the
# other. Dropping every existing copy first also keeps PATH from growing.
if [ -n "${RC_VENV:-}" ]; then
  export VIRTUAL_ENV="$RC_VENV"
  _rc_path=":$PATH:"
  while [[ $_rc_path == *":$VIRTUAL_ENV/bin:"* ]]; do
    _rc_path="${_rc_path/":$VIRTUAL_ENV/bin:"/:}"
  done
  _rc_path="${_rc_path#:}"
  export PATH="$VIRTUAL_ENV/bin${_rc_path:+:${_rc_path%:}}"
  unset _rc_path
fi
