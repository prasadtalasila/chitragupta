%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontSize": "14px",
    "primaryColor": "#E6F1F7",
    "primaryBorderColor": "#0072B2",
    "primaryTextColor": "#1A1A1A",
    "lineColor": "#0072B2",
    "secondaryColor": "#E6F5F1",
    "secondaryBorderColor": "#009E73",
    "tertiaryColor": "#FBEFE6",
    "tertiaryBorderColor": "#D55E00"
  }
}}%%
flowchart TB
  GL[/"scope.md glossaries"/] --> BUILD
  SY[/"math.md ## Symbols"/] --> BUILD
  TOML[/"specs/&lt;book&gt;/index.toml"/] --> BUILD
  BUILD["registry build --index<br/><small>validates; exit 1 on a bad index.toml</small>"] --> TERMS
  TERMS[/"rendered/&lt;book&gt;/index-terms.json"/]
  UNIT[/"&lt;unit&gt;.md"/] --> RENDER
  TERMS --> RENDER
  RENDER["render --fragment --index-terms<br/><small>the Lua filter: match, count, place</small>"]
  RENDER --> TEX[/"&lt;unit&gt;.tex<br/><small>one index entry per term, by id</small>"/]
  RENDER --> SIDE[/"&lt;unit&gt;.index.json<br/><small>counts and casing</small>"/]
  TEX --> PASSES["book.tex: lualatex, bibtexu,<br/>lualatex, lualatex"]
  PASSES --> IDX[/"book.idx"/]
  IDX --> FINISH
  TERMS --> FINISH
  SIDE --> FINISH
  FINISH["registry index<br/><small>ids to printed entries, see, sub-entries; runs upmendex</small>"]
  FINISH --> IND[/"book.ind"/]
  FINISH --> REPORT[/"specs/&lt;book&gt;/registries/index.md + index.json"/]
  IND --> LAST["lualatex"] --> PDF[/"book.pdf"/]
  class GL,SY,TOML,TERMS,UNIT,TEX,SIDE,IDX,IND,REPORT,PDF alt
  class FINISH key

  %% house roles: generated by scripts/render_diagrams.py --sync
  classDef flow fill:#E6F1F7,stroke:#0072B2,stroke-width:1.4px,color:#1A1A1A
  classDef alt fill:#E6F5F1,stroke:#009E73,stroke-width:1.4px,color:#1A1A1A
  classDef key fill:#FBEFE6,stroke:#D55E00,stroke-width:2px,color:#1A1A1A
  classDef absent fill:#FFFFFF,stroke:#8C8C8C,stroke-width:1.2px,stroke-dasharray:4 3,color:#1A1A1A
