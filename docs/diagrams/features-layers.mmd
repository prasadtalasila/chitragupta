flowchart TB
  L1["<b>Layer 1 · Corpus</b> — deterministic, safe unattended<br/><small>sync · ledger · topics · discover</small>"]:::flow
  L3["<b>Layer 3 · Enrichment</b> — optional, extends the corpus<br/><small>docling · embeddings · topic model · seed topics · topic graph</small>"]:::absent
  L2["<b>Layer 2 · Drafting</b> — generative, you review it<br/><small>11 skills · dossier · retrieval · references · evidence · render · style · book pipeline</small>"]:::flow
  GATE{{"<b>chitragupta draft gate</b><br/><small>this layer's only exit</small>"}}:::key
  OUT["rendered document"]:::alt
  L4["<b>Layer 4 · Review</b> — advisory, never a gate<br/><small>11 aids, each exits 0 whatever it finds</small>"]:::flow

  L1 -->|"a ledger to draft from"| L2
  L1 -.->|"optional, never run for you"| L3
  L3 -.->|"read as an artefact, never called"| L2
  L2 --> GATE
  GATE -->|"OK"| OUT
  OUT --> L4

