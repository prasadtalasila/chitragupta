flowchart TB

  Q(["your query<br/><i>“digital twin composability”</i>"])

  subgraph SEARCH["<b>SEARCHING</b>: pick one; nothing merges them"]
    direction TB
    BM25["<b>BM25</b> · <code>retrieval.py</code><br/>stdlib, always available"]
    EMB["<b>semantic</b> · <code>embed_index.py</code><br/>enrich group, a drop-in"]
  end

  subgraph SURVEY["<b>SURVEYING</b>: no query"]
    direction TB
    BERT["<b>BERTopic</b> · <code>topic_model.py</code><br/>clusters the whole corpus"]
    TOP[/"<b>content/topics.json</b><br/>read by you, not by skills"/]
    BERT --> TOP
  end

  HITS(["ranked hits<br/>each with a real citekey"])
  CORPUS[("your corpus")]

  Q --> BM25 --> HITS
  Q -. "if chroma/ exists" .-> EMB
  EMB -.-> HITS
  CORPUS --> BM25
  CORPUS --> EMB
  CORPUS --> BERT
  HITS ~~~ BERT


  class Q,HITS flow
  class BM25 flow
  class EMB,BERT absent
  class TOP,CORPUS alt

  %% house roles: generated by scripts/render_diagrams.py --sync
  classDef flow fill:#E6F1F7,stroke:#0072B2,stroke-width:1.4px,color:#1A1A1A
  classDef alt fill:#E6F5F1,stroke:#009E73,stroke-width:1.4px,color:#1A1A1A
  classDef key fill:#FBEFE6,stroke:#D55E00,stroke-width:2px,color:#1A1A1A
  classDef absent fill:#FFFFFF,stroke:#8C8C8C,stroke-width:1.2px,stroke-dasharray:4 3,color:#1A1A1A
