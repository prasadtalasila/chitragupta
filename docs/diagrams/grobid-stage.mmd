  "theme": "base",
  "themeVariables": {
    "fontSize": "14px",
    "primaryColor": "#E6F1F7",
    "primaryBorderColor": "#0072B2",
    "primaryTextColor": "#1A1A1A",
    "lineColor": "#0072B2",
    "secondaryColor": "#E6F5F1",
    "secondaryBorderColor": "#009E73",
    "tertiaryColor": "#FBEFE6",
    "tertiaryBorderColor": "#D55E00"
  }
}}%%
flowchart TB

  BIB[/"<b>papers/bibliography.bib</b>"/]
  READER["<code>chitragupta/bib_reader.py</code>"]
  LEDGER[("<b>content/ledger.sqlite</b><br/><small>one row per citekey</small>")]
  CORPUS["<code>chitragupta/enrich/corpus.py</code><br/><small>one CorpusDoc per bib item</small>"]

  BIB --> READER --> LEDGER --> CORPUS

  subgraph EX["<b>ENRICHMENT LAYER</b> — <code>chitragupta enrich --stages …</code> · one write lock"]
    direction LR
    DOC["<code>docling_parse.py</code><br/><small>body text, reading order</small>"]
    GRO["<code>grobid_parse.py</code> <b>(NEW)</b><br/><small>header + reference lists</small>"]
  end

  CORPUS --> DOC
  CORPUS --> GRO

  MD[/"content/docling/&lt;citekey&gt;.md<br/>+ .passages.json"/]
  TEI[/"content/grobid/&lt;citekey&gt;.tei.xml"/]
  DOC --> MD
  GRO --> TEI

  EMB["<code>embed_index.py</code> → Chroma<br/><code>topic_model.py</code> → topics.json"]
  CG["<code>citation_graph.py</code> <b>(NEW)</b><br/><small>resolve refs against the ledger</small>"]
  MD --> EMB
  TEI --> CG
  LEDGER -. "the only names an edge may use" .-> CG
  CG --> GRAPH[/"content/citation_graph.json"/]

  class GRO,CG key
  class MD,TEI,GRAPH,BIB alt
  class LEDGER,READER,CORPUS,DOC,EMB flow

  %% house roles: generated by scripts/render_diagrams.py --sync
  classDef flow fill:#E6F1F7,stroke:#0072B2,stroke-width:1.4px,color:#1A1A1A
  classDef alt fill:#E6F5F1,stroke:#009E73,stroke-width:1.4px,color:#1A1A1A
  classDef key fill:#FBEFE6,stroke:#D55E00,stroke-width:2px,color:#1A1A1A
  classDef absent fill:#FFFFFF,stroke:#8C8C8C,stroke-width:1.2px,stroke-dasharray:4 3,color:#1A1A1A
