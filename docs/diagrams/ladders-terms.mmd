%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontSize": "14px",
    "primaryColor": "#E6F1F7",
    "primaryBorderColor": "#0072B2",
    "primaryTextColor": "#1A1A1A",
    "lineColor": "#0072B2",
    "secondaryColor": "#E6F5F1",
    "secondaryBorderColor": "#009E73",
    "tertiaryColor": "#FBEFE6",
    "tertiaryBorderColor": "#D55E00"
  }
}}%%
flowchart TB

  subgraph LAD["<b>LADDER</b>: the code descends, nobody is asked"]
    direction TB
    LQ(["a question with more than one answer"])
    L1{"<b>rung 1</b><br/>most faithful"}
    L2{"<b>rung 2</b>"}
    L3["<b>rung 3</b><br/>worst acceptable"]
    LA(["<b>an answer, always</b><br/>the run does not stop"])
    LQ --> L1
    L1 -- "answers" --> LA
    L1 -- "can't answer" --> L2
    L2 -- "answers" --> LA
    L2 -- "can't answer" --> L3
    L3 --> LA
  end

  subgraph TIE["<b>TIER</b>: you choose, nothing descends"]
    direction TB
    TQ(["a menu: a config key or a flag"])
    T1["option A"]
    T2["<b>option B</b><br/>your pick"]
    T3["option C"]
    TOK(["exactly what you asked for"])
    TNO(["<b>it stops and names what is missing</b>"])
    TQ --> T1 & T2 & T3
    T1 -.-> TOK
    T3 -.-> TOK
    T2 -- "available" --> TOK
    T2 -- "unavailable" --> TNO
  end
  LA ~~~ TQ


  class LQ,TQ flow
  class L1,L2,L3,T2 flow
  class LA,TOK alt
  class TNO key
  class T1,T3 absent

  %% house roles: generated by scripts/render_diagrams.py --sync
  classDef flow fill:#E6F1F7,stroke:#0072B2,stroke-width:1.4px,color:#1A1A1A
  classDef alt fill:#E6F5F1,stroke:#009E73,stroke-width:1.4px,color:#1A1A1A
  classDef key fill:#FBEFE6,stroke:#D55E00,stroke-width:2px,color:#1A1A1A
  classDef absent fill:#FFFFFF,stroke:#8C8C8C,stroke-width:1.2px,stroke-dasharray:4 3,color:#1A1A1A
