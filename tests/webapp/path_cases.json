{
  "comment": [
    "The contract between two runtimes walking one family.",
    "assets/webapp/families.js (computePath) is the browser's Dijkstra",
    "over 1 - strength; chitragupta/enrich/topic_paths.py stores the",
    "same trees as next-hop edge-index matrices and",
    "chitragupta/discover/_paths.py walks them (#714). Node asserts the",
    "browser reproduces every row (tests/webapp/families.test.js),",
    "pytest asserts the stored walk does (tests/test_enrich_topic_paths",
    ".py), so neither can drift alone. Expected values are the path's",
    "label sequence, null where the family holds no path -- an answer,",
    "not an absence. Rows avoid equal-cost ties on purpose: tie-breaks",
    "are implementation order, and the stored matrix is what both",
    "surfaces read when they must agree to the hop."
  ],
  "cases": [
    {
      "name": "the strong route beats the short one",
      "topics": [
        "A",
        "B",
        "C",
        "Z"
      ],
      "edges_overlap": [
        {
          "a": "A",
          "b": "Z",
          "overlap_coeff": 0.1,
          "jaccard": 0.05,
          "p_value": 0.004,
          "shared": [
            "p0"
          ]
        },
        {
          "a": "A",
          "b": "B",
          "overlap_coeff": 0.9,
          "jaccard": 0.5,
          "p_value": 0.001,
          "shared": [
            "p1"
          ]
        },
        {
          "a": "B",
          "b": "C",
          "overlap_coeff": 0.9,
          "jaccard": 0.5,
          "p_value": 0.001,
          "shared": [
            "p2"
          ]
        },
        {
          "a": "C",
          "b": "Z",
          "overlap_coeff": 0.9,
          "jaccard": 0.5,
          "p_value": 0.001,
          "shared": [
            "p3"
          ]
        }
      ],
      "edges_semantic": [
        {
          "a": "A",
          "b": "Z",
          "similarity": 0.9,
          "bridge": [
            "p0",
            "p9"
          ]
        }
      ],
      "pairs": [
        [
          "A",
          "Z"
        ],
        [
          "B",
          "Z"
        ]
      ],
      "expected": {
        "overlap": {
          "A->Z": [
            "A",
            "B",
            "C",
            "Z"
          ],
          "B->Z": [
            "B",
            "C",
            "Z"
          ]
        },
        "semantic": {
          "A->Z": [
            "A",
            "Z"
          ],
          "B->Z": null
        }
      }
    },
    {
      "name": "no path over one family is an answer",
      "topics": [
        "A",
        "B",
        "Y",
        "Z"
      ],
      "edges_overlap": [
        {
          "a": "A",
          "b": "B",
          "overlap_coeff": 0.9,
          "jaccard": 0.5,
          "p_value": 0.001,
          "shared": [
            "p1"
          ]
        }
      ],
      "edges_semantic": [
        {
          "a": "Y",
          "b": "Z",
          "similarity": 0.9,
          "bridge": [
            "p2",
            "p3"
          ]
        }
      ],
      "pairs": [
        [
          "A",
          "Z"
        ],
        [
          "A",
          "B"
        ]
      ],
      "expected": {
        "overlap": {
          "A->Z": null,
          "A->B": [
            "A",
            "B"
          ]
        },
        "semantic": {
          "A->Z": null,
          "A->B": null
        }
      }
    }
  ]
}
